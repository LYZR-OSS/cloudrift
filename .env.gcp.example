# cloudrift on GCP — the environment contract for a consuming service.
#
# Variable names follow lyzr-agent's existing convention (`*_BACKEND_PROVIDER`
# selects the provider; per-provider credentials sit alongside), so adding GCP is
# a config change plus widening the Literal on each provider field.
#
#   cp .env.gcp.example .env && edit
#   uv run python scripts/gcp_service_smoke.py

# ---------------------------------------------------------------------------
# Platform + credentials
# ---------------------------------------------------------------------------

CLOUD_PLATFORM=gcp
GCP_PROJECT=your-project-id

# Identity: pick ONE, or none.
#
# Leave all three unset on GKE/Cloud Run — Application Default Credentials pick
# up the attached service account, which is the intended production path.
#
# GCP_SERVICE_ACCOUNT_FILE=/etc/gcp/sa.json
#   A key file on disk. Note this also makes GCS sign URLs *locally*, so
#   GCS_SIGNER_SERVICE_ACCOUNT is then unnecessary.
#
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#   The key as inline JSON — for keys held in a secret store that should never
#   touch disk. cloudrift wraps it in memory.
#
# GCP_PREFER_METADATA=true
#   Skip ADC's GOOGLE_APPLICATION_CREDENTIALS lookup and read the attached
#   service account straight from the metadata server. Set this in production:
#   ADC checks that env var FIRST, so a stray key path silently shadows the
#   workload's real identity. Not accepted by the GCS factories (gcloud-aio
#   resolves ADC internally with no hook) — the smoke script drops it there.

# ---------------------------------------------------------------------------
# Storage — Cloud Storage
# ---------------------------------------------------------------------------

STORAGE_BACKEND_PROVIDER=gcs
STORAGE_FILES_BUCKET=your-bucket

# Required to generate signed URLs when the credential has NO local private key
# (ADC / Workload Identity). Signing then goes through the IAM signBlob API, and
# the caller needs roles/iam.serviceAccountTokenCreator on this account.
# Omit when using GCP_SERVICE_ACCOUNT_FILE/_JSON, which sign locally.
# GCS_SIGNER_SERVICE_ACCOUNT=svc@your-project-id.iam.gserviceaccount.com

# ---------------------------------------------------------------------------
# Document DB — Firestore with MongoDB compatibility
# ---------------------------------------------------------------------------

DOCUMENT_BACKEND_PROVIDER=firestore

# The UID is the generated UUID in the endpoint hostname, NOT the database ID.
# Read all three from:
#   gcloud firestore databases connection-string --database=YOUR_DB
FIRESTORE_UID=f116f93a-519c-208a-9a72-3ef6c9a1f081
FIRESTORE_LOCATION=us-central1
FIRESTORE_DATABASE=your-db

# The database must be created in MongoDB-compatibility mode (enterprise
# edition). A default/native Firestore database does NOT speak the Mongo wire
# protocol and will not work here.

# ---------------------------------------------------------------------------
# Messaging — Pub/Sub
# ---------------------------------------------------------------------------

MESSAGING_BACKEND_PROVIDER=gcp_pubsub

# Pub/Sub splits a queue into a topic (send) and a subscription (receive), but
# the service config carries ONE identifier per queue. The convention here keeps
# that contract: the identifier is the topic, and the subscription is derived by
# suffix. Create both, e.g. topic "credit-consumption" + subscription
# "credit-consumption-sub".
CREDIT_CONSUMPTION_QUEUE=credit-consumption
GCP_PUBSUB_SUBSCRIPTION_SUFFIX=-sub

# ---------------------------------------------------------------------------
# Cache — Memorystore
# ---------------------------------------------------------------------------

# Memorystore has only a private VPC IP, so this is unreachable from a laptop.
# Leave CACHE_BACKEND_PROVIDER=redis for local work and set memorystore only
# where the service actually runs (GKE/Cloud Run with a VPC connector, or a GCE VM).
CACHE_BACKEND_PROVIDER=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# CACHE_BACKEND_PROVIDER=memorystore
# REDIS_HOST=10.0.0.3
# MEMORYSTORE_AUTH_STRING=...

# ---------------------------------------------------------------------------
# Secrets + crypto
# ---------------------------------------------------------------------------

SECRETS_BACKEND_PROVIDER=gcp_secret_manager
CRYPTO_BACKEND_PROVIDER=gcp_kms
GCP_KMS_KEY=projects/your-project-id/locations/us-central1/keyRings/your-ring/cryptoKeys/your-key
